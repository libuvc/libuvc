# make sure that .gitignore, .travis.yml,... are not part of a
# source-package generated via 'git archive'
.git*      	export-ignore
/.*		export-ignore

# Test fixtures are raw pixel data; never apply line-ending conversion.
*.yuyv	binary
*.uyvy	binary
*.rgb	binary
*.bgr	binary
*.y	binary
*.uv	binary
